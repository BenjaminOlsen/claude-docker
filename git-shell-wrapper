#!/bin/bash
# Intercepts SSH commands for the git user.
# Auto-initializes bare repos on first access, then delegates to git-shell.

set -euo pipefail

REPOS_DIR="/home/git/repos"
HOOKS_DIR="/home/git/hooks"

# SSH_ORIGINAL_COMMAND is set by sshd with the command the client sent
CMD="${SSH_ORIGINAL_COMMAND:-}"

if [ -z "$CMD" ]; then
    echo "Interactive login disabled. Use git push/pull." >&2
    exit 1
fi

# Extract the git command and repo path from commands like:
#   git-receive-pack '/repos/myproject.git'
#   git-upload-pack '/repos/myproject.git'
GIT_CMD="${CMD%% *}"
REPO_ARG="${CMD#* }"

# Strip surrounding quotes
REPO_ARG="${REPO_ARG#\'}"
REPO_ARG="${REPO_ARG%\'}"
REPO_ARG="${REPO_ARG#\"}"
REPO_ARG="${REPO_ARG%\"}"

case "$GIT_CMD" in
    git-receive-pack|git-upload-pack)
        # Normalize: strip leading slashes, ensure .git suffix
        REPO_PATH="${REPO_ARG#/}"
        REPO_PATH="${REPO_PATH#repos/}"
        [[ "$REPO_PATH" != *.git ]] && REPO_PATH="${REPO_PATH}.git"

        FULL_PATH="${REPOS_DIR}/${REPO_PATH}"

        # Auto-init bare repo if it doesn't exist
        if [ ! -d "$FULL_PATH" ]; then
            echo "Initializing new repository: ${REPO_PATH}" >&2
            git init --bare "$FULL_PATH" >/dev/null 2>&1
            git -C "$FULL_PATH" config receive.advertisePushOptions true
            chown -R git:git "$FULL_PATH"

            # Copy default hooks
            if [ -d "$HOOKS_DIR" ]; then
                for hook in "$HOOKS_DIR"/*; do
                    [ -f "$hook" ] || continue
                    cp "$hook" "$FULL_PATH/hooks/"
                    chmod +x "$FULL_PATH/hooks/$(basename "$hook")"
                done
            fi

            echo "Repository ready." >&2
        fi

        # Delegate to git-shell with the canonical path
        exec /usr/bin/git-shell -c "$GIT_CMD '${FULL_PATH}'"
        ;;
    *)
        # Unknown command -- let git-shell decide
        exec /usr/bin/git-shell -c "$CMD"
        ;;
esac
