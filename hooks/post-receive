#!/bin/bash
# Post-receive hook: triggers Claude to work on pushed code autonomously.
#
# For each pushed branch:
#   1. Clones the bare repo into a timestamped work directory
#   2. Looks for AGENTS.md (or CLAUDE.md) for instructions
#   3. Launches Claude headlessly to work on the code
#
# Claude runs inside a tmux session so you can attach and watch:
#   docker exec -it claude-docker tmux attach -t <session-name>

set -euo pipefail

# Clear git environment variables inherited from git-receive-pack.
# These interfere with git clone/checkout operations inside the hook.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_QUARANTINE_PATH GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES

# Ensure PATH includes npm global bin (where claude is installed)
export PATH="/usr/local/bin:/usr/bin:/bin:$PATH"

REPOS_DIR="/home/git/repos"
WORK_DIR="/home/git/work"
LOG_DIR="/home/git/logs"
mkdir -p "$LOG_DIR"

# Determine repo name from the bare repo path
BARE_REPO="$(pwd)"
REPO_NAME="$(basename "$BARE_REPO" .git)"

while read -r OLD_REV NEW_REV REF; do
    # Skip deleted branches
    if [[ "$NEW_REV" =~ ^0+$ ]]; then
        continue
    fi

    # Only process branch pushes
    case "$REF" in
        refs/heads/*) ;;
        *) continue ;;
    esac

    BRANCH="${REF#refs/heads/}"
    BRANCH_SAFE="${BRANCH//\//_}"
    TIMESTAMP="$(date +%Y-%m-%d/%H_%M_%S)"
    CLONE_DIR="${WORK_DIR}/${REPO_NAME}/${BRANCH_SAFE}/${TIMESTAMP}"
    LOGFILE="${LOG_DIR}/${REPO_NAME}_${BRANCH_SAFE}_$(date +%Y%m%d_%H%M%S).log"

    echo "==> Claude Docker: received push to ${REPO_NAME}/${BRANCH}" >&2
    echo "==> Work directory: ${CLONE_DIR}" >&2
    echo "==> Log file: ${LOGFILE}" >&2

    # Clone into work directory
    mkdir -p "$(dirname "$CLONE_DIR")"
    git clone "$BARE_REPO" "$CLONE_DIR" >&2
    cd "$CLONE_DIR"
    git checkout "$BRANCH" >&2

    # Configure git identity for Claude's commits
    git config user.name "Claude"
    git config user.email "claude@docker.local"

    # Read push options (git push -o prompt="..." -o key=value)
    PUSH_PROMPT=""
    if [ -n "${GIT_PUSH_OPTION_COUNT:-}" ]; then
        for i in $(seq 0 $((GIT_PUSH_OPTION_COUNT - 1))); do
            OPT_VAR="GIT_PUSH_OPTION_$i"
            OPT="${!OPT_VAR}"
            case "$OPT" in
                prompt=*)
                    PUSH_PROMPT="${OPT#prompt=}"
                    echo "==> Push option prompt: ${PUSH_PROMPT}" >&2
                    ;;
            esac
        done
    fi

    # Check for a repo-specific hook override
    if [ -f ".claude-docker-hook" ] && [ -x ".claude-docker-hook" ]; then
        echo "==> Found .claude-docker-hook - running custom hook instead" >&2
        ./.claude-docker-hook "$OLD_REV" "$NEW_REV" "$BRANCH" 2>&1 | tee "$LOGFILE"
        continue
    fi

    # Build the prompt
    PROMPT="You are working in ${CLONE_DIR}. "

    # Check for instruction files in priority order
    if [ -f "AGENTS.md" ]; then
        PROMPT+="Read and follow the instructions in AGENTS.md. "
        echo "==> Found AGENTS.md - Claude will follow its instructions" >&2
    elif [ -f "CLAUDE.md" ]; then
        PROMPT+="Read and follow the instructions in CLAUDE.md. "
        echo "==> Found CLAUDE.md - Claude will follow its instructions" >&2
    else
        PROMPT+="Analyze the codebase thoroughly. Look for TODOs, bugs, and improvements. "
        echo "==> No AGENTS.md or CLAUDE.md found - Claude will analyze the code" >&2
    fi

    # Append the push option prompt (overrides or augments the instruction file)
    if [ -n "$PUSH_PROMPT" ]; then
        PROMPT+="IMPORTANT additional instructions from the user: ${PUSH_PROMPT} "
    fi

    # Append common instructions
    PROMPT+="When you are done, commit your changes with clear commit messages. "
    PROMPT+="Push your commits to origin/${BRANCH} when finished. "
    PROMPT+="Work autonomously - do not ask questions, make your best judgment."

    # Session name for tmux (sanitized)
    SESSION_NAME="claude-${REPO_NAME}-${BRANCH}"
    SESSION_NAME="${SESSION_NAME//[^a-zA-Z0-9_-]/_}"

    # Kill any existing tmux server (cleans up stale sockets).
    # Without this, killing the last session leaves a dead socket that
    # causes "server exited unexpectedly" on the next new-session.
    tmux kill-server 2>/dev/null || true
    sleep 0.5

    echo "==> Starting Claude in tmux session: ${SESSION_NAME}" >&2
    echo "==> Attach with: ./run.sh --attach ${SESSION_NAME}" >&2

    # Launch Claude in print mode with streaming JSON output.
    # Plain -p produces no output until done; stream-json gives live progress.
    # Pipe through jq to extract readable text and tool calls.
    JQ_FILTER_FILE="${CLONE_DIR}/.claude-stream-filter.jq"
    cat > "$JQ_FILTER_FILE" << 'JQEOF'
def format_tool:
  if .name == "Read" then
    ">>> Read: \(.input.file_path)\(if .input.offset then " (lines \(.input.offset)-\(.input.offset + (.input.limit // 200)))" else "" end)"
  elif .name == "Bash" then
    ">>> $ \(.input.command[:150])"
  elif .name == "Edit" then
    ">>> Edit: \(.input.file_path)"
  elif .name == "Write" then
    ">>> Write: \(.input.file_path)"
  elif .name == "Glob" then
    ">>> Glob: \(.input.pattern)"
  elif .name == "Grep" then
    ">>> Grep: \(.input.pattern)\(if .input.path then " in \(.input.path)" else "" end)"
  elif .name == "Task" then
    ">>> Agent: \(.input.description // .input.prompt[:80])"
  else
    ">>> \(.name): \(.input.description // (.input | tostring)[:100])"
  end;
def format_content:
  if type == "array" then
    .[] | format_content
  elif .type == "thinking" then
    "[thinking] \(.thinking[:300])"
  elif .type == "text" then
    .text
  elif .type == "tool_use" then
    format_tool
  else
    empty
  end;
if .type == "assistant" then
  .message.content | format_content
elif .type == "user" and .tool_use_result then
  if (.tool_use_result | type) == "string" then
    "    \(.tool_use_result[:200])"
  elif .tool_use_result.stdout then
    "    \((.tool_use_result.stdout // "")[:200])"
  else
    empty
  end
elif .type == "result" then
  "\n=== Done (cost: $\(.total_cost_usd // 0)) ==="
else
  empty
end
JQEOF

    tmux new-session -d -s "$SESSION_NAME" -c "$CLONE_DIR" \
        "claude -p '${PROMPT}' --dangerously-skip-permissions --output-format stream-json --verbose 2>&1 | tee '${LOGFILE}.json' | jq -r --unbuffered -f '${JQ_FILTER_FILE}' | tee '${LOGFILE}'; echo '=== Claude finished at \$(date) ===' >> '${LOGFILE}'"

    echo "==> Claude is working autonomously on ${REPO_NAME}/${BRANCH}" >&2
    echo "==> Watch live: ./run.sh --attach ${SESSION_NAME}" >&2
    echo "==> Transcript: ${LOGFILE}" >&2
    echo "==> Raw JSON: ${LOGFILE}.json" >&2
done
